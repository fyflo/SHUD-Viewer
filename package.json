{
  "name": "relay-electron-shud-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "SHUD Viewer",
  "author": "",
  "type": "module",
  "main": "dist/electron-main.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "electron:dev": "tsx src/electron-main.ts",
    "electron:build": "tsc -p tsconfig.json",
    "electron:start": "electron dist/electron-main.js",
    "pack": "npm run build && node electron-builder.mjs --dir",
    "dist": "npm run build && node electron-builder.mjs"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^22.10.2",
    "electron": "^34.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "com.fyflo.shudviewer",
    "productName": "SHUD Viewer",
    "icon": "src/img/favicon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/img/**/*",
      "preload.cjs",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "src/img/favicon.ico",
      "target": [
        "nsis"
      ]
    }
  }
}